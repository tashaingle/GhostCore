NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Connect (server-only; never use NEXT_PUBLIC_ prefixes)
STRIPE_PLATFORM_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_REDIRECT_URI=http://localhost:3000/api/integrations/stripe/callback
STRIPE_WEBHOOK_SECRET=
# Required only by the signature-verified unauthenticated webhook handler.
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-search-console/callback

# Shopify (server-only)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=http://localhost:3000/api/integrations/shopify/callback

# Meta Ads reporting (server-only)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta-ads/callback
META_GRAPH_API_VERSION=v25.0
# Meta Social organic (Facebook Page + Instagram). Reuses META_APP_ID/SECRET by default.
META_SOCIAL_REDIRECT_URI=http://localhost:3000/api/integrations/meta-social/callback
# Optional override version for organic Graph calls only.
# META_SOCIAL_GRAPH_API_VERSION=v25.0
# Default OAuth scopes are Page-only (avoids Invalid Scopes before Instagram product is added).
# After adding Instagram Graph API in Meta App Dashboard, either:
# META_SOCIAL_INCLUDE_INSTAGRAM=true
# or set full list:
# META_SOCIAL_SCOPES=pages_show_list,pages_read_engagement,pages_read_user_content,instagram_basic,instagram_manage_insights,read_insights,business_management

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/integrations/linkedin/callback
LINKEDIN_API_VERSION=202607
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/api/integrations/notion/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/integrations/slack/callback
SLACK_ENABLE_PRIVATE_CHANNELS=false

# Phase 17 correlations require no environment variables. Rule definitions and
# safe defaults are reviewed source code; organisation overrides live in Supabase.
# Phase 18 command centre also requires no environment variables.
# Phase 19 scheduler endpoint. Use a long random server-only secret.
BACKGROUND_JOB_SECRET=
# Vercel Cron sends Authorization: Bearer <CRON_SECRET>. Set this to the same
# value as BACKGROUND_JOB_SECRET on Vercel so the built-in daily cron is authorized.
CRON_SECRET=
# Optional number of background jobs run in parallel per dispatch (1-8, default 4).
BACKGROUND_JOB_CONCURRENCY=4
# Optional Phase 20 deterministic notification bounds and thresholds.
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_CRITICAL_FAILURE_THRESHOLD=3
NOTIFICATION_STALE_INTERVAL_MULTIPLIER=2
# Allow Stripe test keys on the live site (labelled test data; ignored by insights).
# STRIPE_ALLOW_TEST_MODE=true
# Email delivery via Resend (Vercel Marketplace provisions RESEND_API_KEY). Email stays off until
# both are set. EMAIL_FROM must use a domain verified in Resend, e.g. "Ghost <alerts@mail.example.com>".
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_ANALYTICS_REDIRECT_URI=http://localhost:3000/auth/google-analytics/callback
# Optional deterministic work-management bounds
WORK_BATCH_SIZE=100
WORK_BLOCKED_WARNING_HOURS=24
WORK_UNASSIGNED_CRITICAL_WARNING_HOURS=4
WORK_DUE_SOON_HOURS=24
# GitHub App (preferred over the OAuth flow): users pick which repositories Ghost can read.
# Callback URL: <site>/api/integrations/github/callback. Permissions: Actions + Metadata, read-only.
# GITHUB_APP_PRIVATE_KEY accepts the PEM with \n escapes or base64-encoded.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
